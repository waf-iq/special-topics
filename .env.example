# Copy to .env and fill in. Nothing here is required for D1 to run locally.

# Optional: override default arXiv API root
ARXIV_API_BASE=http://export.arxiv.org/api/query

# Optional: override default embedding model
EMBEDDING_MODEL=sentence-transformers/bge-small-en

# Optional: Optuna storage URL (default: in-memory). Use sqlite:///optuna_study.db to persist.
OPTUNA_STORAGE=

# Optional: limit number of PDFs ingested (useful for laptop testing)
INGEST_MAX_PDFS=50

# --- D3 external services ---
# Groq free-tier LLM (judge for RAGAS faithfulness/relevance + optional answerer ceiling).
# Get a key at https://console.groq.com — free tier: ~30 rpm / 1K rpd / 12K tpm.
# Required to run evaluate_answers() and build_gold_answers.py.
GROQ_API_KEY=

# --- D2 stores (docker-compose defaults; see D2_TASKS.md) ---
# Mongo: source of truth for papers/chunks (seed_neo4j reads `papers` from here)
MONGO_URL=mongodb://localhost:27017
# Qdrant: dense vector store for /search
QDRANT_URL=http://localhost:6333
# Neo4j: knowledge graph. Dev containers run NEO4J_AUTH=none (leave user/pass unset).
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# FastAPI host port (the `api` compose service maps this -> container 8000)
API_PORT=8000

# --- D3 GraphRAG runtime (Task 7) ---
# Wire the live stores into the app + executor (off by default so tests stay offline).
CSAI415_USE_QDRANT=1
CSAI415_USE_NEO4J=1
# Answer generator: 'groq' (ceiling/judge) | 'qwen2.5:3b-instruct' (graded local SLM via
# Ollama) | 'qwen2.5-3b-csai415' (D4 tuned). Unset ⇒ extractive fallback.
CSAI415_ANSWERER=groq
# Citation style: 'numbered' ([n] inline) | 'posthoc'.
CSAI415_CITE_MODE=numbered
